import random
import string

def gen_pwd(min_length, include_numbers=True, include_special=True):
    letters = string.ascii_letters
    digits = string.digits
    special_chars = string.punctuation
    all_chars = letters
    if include_numbers:
        all_chars += digits
    if include_special:
        all_chars += special_chars
    while True:
        password = ""
        has_number = False
        has_special = False
        for _ in range(min_length):
            char = random.choice(all_chars)
            password += char
            if char in digits:
                has_number = True
            if char in special_chars:
                has_special = True
        if include_numbers and not has_number:
            continue
        if include_special and not has_special:
            continue
        break
    return password
min_length = int(input("Enter the minimum password length: "))
include_numbers = input("Include numbers? (y/n): ").lower() == 'y'
include_special = input("Include special characters? (y/n): ").lower() == 'y'
pwd = gen_pwd(min_length, include_numbers, include_special)
print("Your generated password is:", pwd)
